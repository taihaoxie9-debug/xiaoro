data: {"responsibility":"product_knowledge","mode":"product_knowledge","recommendation_mode":null,"copy_source":"authoritative","sections":[{"kind":"summary","copy_text":"我按你问的内容，整理这款商品的相关信息。","used_fact_ids":[],"used_constraint_ids":[],"advisor_reason":null,"advisor_used_fact_ids":[],"advisor_used_constraint_ids":[],"slot_id":null,"product_id":null,"direct_facts":[]},{"kind":"answer","copy_text":"使用提醒：薇诺娜（WINONA）特护面膜舒敏保湿丝滑面贴膜6片舒缓修护补水保湿：品牌将「商家称该面膜专研敏感肌，并称可用于特殊美容或日晒后；具体信息：敏感肌适用宣称；日晒后适用宣称；特殊美容后适用宣称」作为适用说明。这类说明不能当作个人安全保证；如果正处于泛红、刺痛或破损期，先暂停尝试；皮肤稳定后再局部试用。","used_fact_ids":["evidence:6de5c329a6ab2cb4658decd3d754eb2a742251b8637c736d0e20261ca08fd961"],"used_constraint_ids":[],"advisor_reason":null,"advisor_used_fact_ids":[],"advisor_used_constraint_ids":[],"slot_id":null,"product_id":null,"direct_facts":[]},{"kind":"full_cards","copy_text":null,"used_fact_ids":[],"used_constraint_ids":[],"advisor_reason":null,"advisor_used_fact_ids":[],"advisor_used_constraint_ids":[],"slot_id":null,"product_id":null,"direct_facts":[]}],"requested_comparison_dimensions":[],"comparison_rows":[],"winner":{"status":"not_applicable","winner_product_id":null,"reason":null,"fact_ids":[],"dimension_ids":[],"tie_reason":null},"visible_product_ids":[78],"compact_tags":[{"product_id":78,"label":"天丝膜布","fact_ids":["card:78:mask_material:soft_display"]}],"card_display":{"mode":"single","visible_product_ids":[78],"max_cards":1,"reason":"product"},"telemetry":{"provider":"reviewed_assets","model":"deterministic","prompt_tokens":0,"completion_tokens":0,"total_tokens":0,"latency_ms":0.0,"fallback_reason":null}}

