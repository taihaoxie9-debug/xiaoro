urce-sha256:adb285f2509b2de90f39051461c156d9b52a649c68154c992625d02c172e59b5:image-sha256:97ffe880b8703cabf1cf6f8f250477f52f7e482efcd752658de2566cb2c68665","source_url":"https://img30.360buyimg.com/sku/jfs/t1/383250/21/15716/61048/695b759dF3fe6ba3e/00d63163e1a7e4e6.jpg","recovery_status":"existing_local","resolved_image_file":"011_97ffe880b8703cab.jpg","image_region":[0,500,790,993]},"supporting_sources":[]},"score":0.5248171368861023,"reasons":["semantic_feature_overlap","question_meaning_coverage","free_descriptor_feature_overlap","exact_product_scope"],"covered_dimensions":["usage"]},{"evidence":{"evidence_id":"5f00f32b655573da963ec3725e9744678acd32df48e03d55a103470349571430","product_id":78,"subject_scope":"exact_product","variant_scope":null,"management_label":"merchant_cited_test","transcription_basis":"ocr_exact","exact_text":"1指薇诺娜舒敏保湿丝滑面贴膜\n2来源于第三方测试报告，34位18-40周岁中国消费者使用薇诺娜舒敏保湿丝滑面贴膜后，仪器测试结\n果。结果仅供参考，实际结果因人而异。\n3来源于第三方测试报告，34位18-40周岁中国女性消费者使用薇诺娜舒敏保湿丝滑面贴膜后，仪器测\n试结果。相比于热风刺激，皮肤红区面积-49.5%，有显著改善。\n4来源于第三方测试报告，34位18-40周岁中国女性消费者使用薇诺娜舒敏保湿丝滑面贴膜后，仪器测\n试结果。相比于热风刺激，皮肤温度-4.8℃，有显著改善。\n5指透明质酸钠\n6马齿苋精粹：一种含有马齿苋提取物的制备方法及用途，ZL0910665804.6\n7指能够吸附面膜布自重10倍的精华液\n8来源于第三方测试报告，35位18-35周岁中国敏感肌消费者使用薇诺娜舒敏保湿丝滑面贴膜后，消费\n者自评结果。结果仅供参考，实际结果因人而异。","plain_meaning":"脚注限定了34人仪器测试、35人消费者自评、实际效果因人而异，以及玻尿酸、马齿苋和10倍承载力含义。","relations":[{"subject":"功效测试","predicate":"merchant_test_qualifier","object":"34位18-40岁中国消费者、仪器测试"},{"subject":"体验认同","predicate":"merchant_test_qualifier","object":"35位18-35岁中国敏感肌消费者、消费者自评"},{"subject":"10倍","predicate":"merchant_footnote_definition","object":"吸附面膜布自重10倍的精华液"}],"qualifiers":{"sample_size":null,"population":null,"method":null,"baseline":null,"duration":null,"disclaimer":"结果仅供参考，实际结果因人而异","footnotes":["1至8号脚注"]},"free_descriptors":["10倍承载力定义","34人仪器测试","35人消费者自评","测试脚注"],"review_status":"accepted","allowed_uses":["answer","display"],"forbidden_uses":["hard_filter","safety_guarantee"],"review_rationale":"脚注本身是回答测试方法与限定条件的关键资产，并为主图证据提供支持来源。","selection_review":{"decision":"answer_only","visual_confirmed":true,"rationale":"该块用于解释体外、脚注、样本、历史、计算口径或跨干预边界，不直接形成当前成品相对效果得分。","projections":[]},"source":{"source_file":"detail_78_ocr.json","source_sha256":"adb285f2509b2de90f39051461c156d9b52a649c68154c992625d02c172e59b5","image_file":"012_a1ff84564f6b7d71.jpg","image_index":12,"image_sha256":"a1ff84564f6b7d715ac509e6dd9cfae94e4459ce1ca828aa1c260f4d9f2ddf14","source_locator":"urn:xiaoro:product-detail-image:pid:78:source-sha256:adb285f2509b2de90f39051461c156d9b52a649c68154c992625d02c172e59b5:image-sha256:a1ff84564f6b7d715ac509e6dd9cfae94e4459ce1ca828aa1c260f4d9f2ddf14","source_url":"https://img30.360buyimg.com/sku/jfs/t1/378622/18/21458/48851/695b759dFe0fb1d13/00d63161f0cfda50.jpg","recovery_status":"existing_local","resolved_image_file":"012_a1ff84564f6b7d71.jpg","image_region":[0,0,790,496]},"supporting_sources":[]},"score":0.30012568077084206,"reasons":["semantic_feature_overlap","question_meaning_coverage","free_descriptor_unigram_overlap","exact_product_scope"],"covered_dimensions":["suitable_skin"]}],"safety_caveats":["这段内容是品牌给出的安全说明，不能把它当作个人安全保证。"],"missing_aspects":[],"ambiguity_reasons":[]}}

