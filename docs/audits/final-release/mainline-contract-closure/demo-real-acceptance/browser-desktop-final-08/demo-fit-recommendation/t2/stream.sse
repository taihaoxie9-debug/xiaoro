:"merchant_claim","transcription_basis":"visual_transcription","exact_text":"轻盈肤感，精华凝露质地，不搓泥；植物治愈系调香，水生清冽香调","plain_meaning":"商家称产品是轻盈凝露质地、不搓泥，并采用水生清冽香调。","relations":[{"subject":"第六代绿宝瓶精华","predicate":"merchant_texture_claim","object":"轻盈、凝露、不搓泥"},{"subject":"产品香调","predicate":"merchant_fragrance_claim","object":"水生清冽香调"}],"qualifiers":{"sample_size":null,"population":null,"method":null,"baseline":null,"duration":null,"disclaimer":null,"footnotes":["“治愈系”指调香带来的愉悦感受，不是医疗作用"]},"free_descriptors":["不搓泥","凝露质地","水生清冽香调","轻盈肤感"],"review_status":"accepted","allowed_uses":["answer","compare","display","weak_soft_rank"],"forbidden_uses":["hard_filter","safety_guarantee"],"review_rationale":"普通质地和香调宣传可回答、比较和弱排序；保留“非医疗作用”脚注。","selection_review":{"decision":"projected","visual_confirmed":true,"rationale":"该块已有视觉审核排序权限，并与同商品人工标准化Merchant Claim原文回链；复用其字段和值，不按宣传出现次数加分。","projections":[{"field_key":"fragrance_description","normalized_value":"水生清冽香调","capabilities":["compare","soft_rank"],"rank_strength":1,"safety_role":"ordinary"},{"field_key":"texture","normalized_value":"不搓泥","capabilities":["compare","soft_rank"],"rank_strength":1,"safety_role":"ordinary"},{"field_key":"texture","normalized_value":"凝露质地","capabilities":["compare","soft_rank"],"rank_strength":1,"safety_role":"ordinary"},{"field_key":"texture","normalized_value":"轻盈","capabilities":["compare","soft_rank"],"rank_strength":1,"safety_role":"ordinary"}]},"source":{"source_file":"detail_39_ocr.json","source_sha256":"20559cc48dfe4e966472896266e04df3566fec99045e5f28210981bd5933e913","image_file":"006_a5ec4904565abe1b.jpg","image_index":6,"image_sha256":"a5ec4904565abe1be3e295c84bc2a69cb8500f69e964a0d42298972ba672b925","source_locator":"urn:xiaoro:product-detail-image:pid:39:source-sha256:20559cc48dfe4e966472896266e04df3566fec99045e5f28210981bd5933e913:image-sha256:a5ec4904565abe1be3e295c84bc2a69cb8500f69e964a0d42298972ba672b925","source_url":"https://img30.360buyimg.com/sku/jfs/t1/464298/30/19582/186228/6a4799fcF3c4f41